{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the GugleFS configuration window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "autostart:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/Gu-ZT/GugleFS/releases" }]
    }
  ]
}
